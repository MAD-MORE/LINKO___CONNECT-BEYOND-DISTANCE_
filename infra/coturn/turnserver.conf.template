# Production-facing coturn configuration (template)
# Replace STATIC_AUTH_SECRET and external-ip appropriately
listening-port=3478
listening-ip=0.0.0.0
relay-ip=0.0.0.0
external-ip=
fingerprint
use-auth-secret
static-auth-secret=STATIC_AUTH_SECRET
realm=linko.example.com
tls-listening-port=5349
cert=/etc/coturn/ssl/fullchain.pem
pkey=/etc/coturn/ssl/privkey.pem
no-stdout-log
