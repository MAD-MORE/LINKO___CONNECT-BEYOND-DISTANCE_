PORT=8080
NODE_ENV=production
# Set these only in the deployment secret manager; never commit real values.
LINKO_DATABASE_URL=postgresql://postgres:<PASSWORD>@db.pbnvssbtshvesqwhckfa.supabase.co:5432/postgres
DATABASE_SSL=true
SUPABASE_URL=https://pbnvssbtshvesqwhckfa.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Privileged Supabase secret; server-side only. Never ship this to Android.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
LINKO_AUTH_SECRET=replace-with-a-random-32-byte-secret
LINKO_BOOTSTRAP_SECRET=replace-with-a-random-bootstrap-secret

# JWT secret for device tokens (min 32 chars — generate with: openssl rand -hex 32)
LINKO_JWT_SECRET=replace-with-min-32-char-random-secret

# Admin secret for /v1/admin/* routes
LINKO_ADMIN_SECRET=replace-with-admin-secret

# FCM server key for push notifications (from Firebase console)
FCM_SERVER_KEY=

# Relay configuration (set to your deployed relay node)
TUNNEL_HOST=linko-relay.fly.dev
TUNNEL_PORT=7000
RELAY_REGION=iad
