PORT=8080
NODE_ENV=production
# Set these only in the deployment secret manager; never commit real values.
LINKO_DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<SUPABASE_PROJECT_REF>.supabase.co:5432/postgres
DATABASE_SSL=true
LINKO_AUTH_SECRET=replace-with-a-random-32-byte-secret
LINKO_BOOTSTRAP_SECRET=replace-with-a-random-bootstrap-secret
